# The server's settings. Copy to server/.dev.vars (which is never committed) and fill in.
# The same names are the server's settings when it is hosted. For mainnet: change the values, nothing else.

# Which network, and the game's contract on it
NEAR_NETWORK=testnet
NEAR_CONTRACT=kail-game.testnet

# The account and key the server signs with: it lands catches and holds the draws, and pays the network's fee
# for each. An account of its own, not the contract's: the contract's account holds the prize vault.
# `npm run server-account` makes it, names it to the contract and writes these two lines. The key may only call
# `land` and `settle_draw` on the contract; never a full-access key.
NEAR_ACCOUNT=kail-server.testnet
NEAR_KEY=ed25519:...

# Signs the tickets the server hands out for a sea: any long random text. (Without it NEAR_KEY is used.)
# SEA_KEY=...

# The game's helper for new players and for NEAR Auth (server/relay.mjs). Its key is read from
# ~/.near-credentials/<network>/<account>.json; scripts/welcome-account.mjs makes the account on testnet.
# The contract has to name it as its greeter (set_greeter).
WELCOME=kail-welcome.testnet
# Where the server is hosted there is no such folder: give the key here instead.
# WELCOME_KEY=ed25519:...

# What a NEAR Auth approval has to pay back, in yoctoNEAR (default 0.005 NEAR; the pages' SIGN_FEE in src/network.js)
# RELAY_FEE=5000000000000000000000

# NEAR Auth's sign-in. Testnet needs nothing here. On mainnet: what NEAR Auth hands out with its approval.
# NEAR_AUTH_ISSUER=https://<your domain from NEAR Auth>/
# NEAR_AUTH_CLIENT=<your client id>

# A node of NEAR of the server's own (a paid or keyed one). Without it the free public nodes are asked,
# and those turn a busy server away.
# NEAR_RPC=https://...

# The computer's boats (testnet only): account=Name, separated by commas. scripts/npc-accounts.mjs makes them.
# NPCS=kail-old-tom.testnet=Old Tom,kail-maggie.testnet=Maggie

# When the boats run by themselves (server/boats.mjs, for a game hosted on Cloudflare): the hosted game's address,
# and the password it shares with the hosted server (npm run secrets makes one up and writes it here).
# KAIL_SERVER=https://kail.example.workers.dev
# BOATS_TOKEN=...
